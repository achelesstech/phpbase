#!/bin/sh
# nginx, in the foreground. It starts once PHP-FPM's socket exists, or after
# 10 s at most, so the first requests are not answered with 502. `-e stderr`
# keeps nginx from opening its compiled-in error log before reading the config.
# SIGQUIT (./down-signal) is its graceful stop: in-flight requests finish first.
SOCK=/tmp/php-base/php-fpm.sock

i=0
while [ ! -S "$SOCK" ] && [ "$i" -lt 100 ]; do
    sleep 0.1
    i=$((i + 1))
done
exec nginx -e stderr -g 'daemon off;'
