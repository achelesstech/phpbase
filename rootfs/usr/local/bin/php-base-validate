#!/bin/sh
# =============================================================================
# php-base-validate — test the nginx AND php-fpm configuration, leave nothing
# =============================================================================
#   COPY docker/vhost.conf /etc/nginx/conf.d/default.conf
#   RUN php-base-validate            (nginx-validate.sh is the same command)
#
# so a broken vhost or pool file fails the BUILD instead of production.
#
# Why a wrapper: nginx's pid and temp paths, the rendered main.d and http.d
# includes and FPM's runtime pool include all live under /tmp/php-base, which
# only exists in a running container (the entrypoint renders it). Outside one, this
# creates a representative skeleton for the test and deletes it afterwards —
# so a build step running as root cannot bake root-owned files into a
# directory the www-data runtime must own.
#
# Inside a running container it tests the live configuration, touching nothing.
# =============================================================================
set -eu

CONF="${1:-/etc/nginx/nginx.conf}"
RUNTIME=/tmp/php-base

if [ ! -f "$RUNTIME/role" ]; then
    # Remove the directory itself too: one left behind root-owned in an image
    # layer would be unwritable for the www-data entrypoint.
    cleanup() { rm -rf "$RUNTIME"; }
    trap cleanup EXIT

    mkdir -p "$RUNTIME/fpm" "$RUNTIME/php" "$RUNTIME/nginx/main.d" "$RUNTIME/nginx/http.d" \
             "$RUNTIME/nginx/tmp/client-body" "$RUNTIME/nginx/tmp/proxy" \
             "$RUNTIME/nginx/tmp/fastcgi" "$RUNTIME/nginx/tmp/uwsgi" \
             "$RUNTIME/nginx/tmp/scgi"
    printf '[www]\n' > "$RUNTIME/fpm/zz-runtime.conf"
    printf '%s\n' \
        '# php-base-validate: representative rendered settings' \
        'worker_processes 2;' \
        > "$RUNTIME/nginx/main.d/10-php-base.conf"
    printf '%s\n' \
        '# php-base-validate: representative rendered settings' \
        'client_max_body_size 64M;' \
        'real_ip_header X-Forwarded-For;' \
        'real_ip_recursive on;' \
        'set_real_ip_from 10.0.0.0/8;' \
        'include /etc/nginx/php-base/cloudflare-real-ip.conf;' \
        'fastcgi_read_timeout 300s;' \
        'access_log /dev/stdout main;' \
        > "$RUNTIME/nginx/http.d/10-php-base.conf"
fi

nginx -t -e stderr -c "$CONF"
php-fpm -t
