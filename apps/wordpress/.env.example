# Copy to .env. Never commit .env.

# Must match the public URL exactly (scheme included) or WordPress
# redirect-loops behind Traefik/Cloudflare.
WORDPRESS_URL=https://example.com

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=
WORDPRESS_TABLE_PREFIX=wp_

# Used only by the one-shot `install` service.
WORDPRESS_SITE_TITLE=My Site
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=

# Allow plugin/theme installation from the admin UI. Off in production: the
# container filesystem is not the source of truth and anything installed there
# is lost on the next deploy. Commit plugins to the repo instead.
# WORDPRESS_ALLOW_UPDATES=true

# ── Optional runtime overrides handled by php-base ───────────────────────────
# PHP_MEMORY_LIMIT=512M
# PHP_UPLOAD_MAX_FILESIZE=128M    # Cloudflare free tier caps uploads at 100MB
# FPM_MAX_CHILDREN=16
