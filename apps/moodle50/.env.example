# Copy to .env. Never commit .env.

MOODLE_URL=https://lms.example.com

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=

# Used only by the one-shot `install` service.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=
MOODLE_SITE_NAME=Moodle

# ── Redis sessions ───────────────────────────────────────────────────────────
# REQUIRED before scaling the app service past one replica — the default
# on-disk session store is not shared between containers.
# MOODLE_SESSION_HANDLER=redis
# MOODLE_SESSION_REDIS_HOST=redis

# ── Cron ─────────────────────────────────────────────────────────────────────
# Use the sidecar (default) OR set this on the app container — never both.
# MOODLE_RUN_CRON=true
