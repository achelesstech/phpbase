# Copy to .env. Never commit .env.
# Compose reads this file; the container reads it via `env_file:`.

APP_NAME=Laravel
APP_KEY=
APP_URL=https://app.example.com

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# Generate with: docker compose run --rm artisan key:generate --show

# ── Optional runtime overrides handled by php-base ───────────────────────────
# PHP_MEMORY_LIMIT=512M
# PHP_UPLOAD_MAX_FILESIZE=128M
# PHP_POST_MAX_SIZE=128M
# FPM_MAX_CHILDREN=16
