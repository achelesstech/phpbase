# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ── Laravel ──
APP_KEY=            # php artisan key:generate --show
APP_URL=https://example.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# ── Moodle (docker-compose.moodle.example.yml) ──
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=
MOODLE_URL=https://lms.example.com

# ── Runtime PHP overrides (optional, any container) ──
# PHP_MEMORY_LIMIT=768M
# PHP_UPLOAD_MAX_FILESIZE=200M
# PHP_POST_MAX_SIZE=200M
# PHP_SESSION_COOKIE_SECURE=0     # only for plain-HTTP local dev
# ENABLE_XDEBUG=true
