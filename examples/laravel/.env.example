# =============================================================================
# Laravel on php-base — copy to .env and fill in. Never commit .env.
# =============================================================================
# Compose reads this file twice: for ${…} in compose*.yml, and as `env_file:`
# for every Laravel container (app, queue, scheduler, migrate).

# ── Routing (compose.prod.yml, Traefik labels) ──────────────────────────────
# The public host name. Its DNS A/AAAA record points at the VPS.
APP_DOMAIN=app.example.com
# The Traefik router and service name. Unique on the HOST, not just in this
# file: two stacks with the same name silently merge into one route. Name it
# after the site (shop, intranet), never `app`.
TRAEFIK_ROUTER=myapp
# Which certificate resolver issues the TLS certificate. Decided by where the
# domain's DNS is hosted, not where it was registered:
#   cloudflare   DNS on Cloudflare (DNS-01 through the Cloudflare API token).
#                The default.
#   letsencrypt  DNS anywhere else: Namecheap, GoDaddy, a local registrar, your
#                own DNS (HTTP-01). The domain must point straight at the VPS
#                (no proxy or CDN in front) and port 80 must be open to the
#                internet before Traefik first sees this router.
TRAEFIK_CERT_RESOLVER=cloudflare

# ── Laravel ──────────────────────────────────────────────────────────────────
APP_NAME=Laravel
# Generate once and keep it:  echo "base64:$(openssl rand -base64 32)"
# Changing it logs everyone out and makes encrypted data unreadable.
APP_KEY=
APP_URL=https://${APP_DOMAIN}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# The root filesystem is read-only: logs go to the container output
# (docker compose logs), not to storage/logs.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
# Required: PostgreSQL will not initialise without one.  openssl rand -hex 24
DB_PASSWORD=

# Sessions, cache and queue in the database: nothing to write on the
# read-only filesystem, and the same state for every container. Redis works
# too; file drivers do not (storage/framework is read-only).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Uploads and other files: storage/app is the one writable volume.
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── php-base ─────────────────────────────────────────────────────────────────
# The app container is healthy only when PHP-FPM answers AND Laravel's own
# health route (/up) returns 200. Ignored by queue and scheduler.
HEALTHCHECK_URL=http://127.0.0.1:8080/up

# Optional runtime overrides; the defaults suit most apps.
# PHP_MEMORY_LIMIT=256M
# PHP_UPLOAD_MAX_FILESIZE=64M
# PHP_POST_MAX_SIZE=64M        # raising it? size the /tmp tmpfs to 2 x this + 32 MB
# FPM_MAX_CHILDREN=auto        # sized from mem_limit; see README.md
