# Keep the build context small and secrets out of it.
.git
.github
.gitignore
.env
.env.*
!.env.example

node_modules
vendor
public/build
public/hot
public/storage

storage/app/*
!storage/app/.gitignore
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

bootstrap/cache/*
!bootstrap/cache/.gitignore

tests
phpunit.xml
phpstan.neon
.phpunit.result.cache

compose*.yml
docker-compose*.yml
Dockerfile
*.md
!README.md

.idea
.vscode
.DS_Store
