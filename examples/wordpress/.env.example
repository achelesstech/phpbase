# =============================================================================
# WordPress on php-base — copy to .env and fill in. Never commit .env.
# =============================================================================
# Compose reads this file twice: for ${…} in compose*.yml, and as `env_file:`
# for every WordPress container (app, scheduler, migrate). wp-config.php reads
# the WORDPRESS_* settings from the environment.

# ── Routing (compose.prod.yml, Traefik labels) ──────────────────────────────
# The public host name. Its DNS A/AAAA record points at the VPS.
APP_DOMAIN=www.example.com
# The Traefik router and service name. Unique on the HOST, not just in this
# file: two stacks with the same name silently merge into one route. Name it
# after the site (blog, shop), never `app`.
TRAEFIK_ROUTER=mysite
# Which certificate resolver issues the TLS certificate. Decided by where the
# domain's DNS is hosted, not where it was registered:
#   cloudflare   DNS on Cloudflare (DNS-01 through the Cloudflare API token).
#                The default.
#   letsencrypt  DNS anywhere else: Namecheap, GoDaddy, a local registrar, your
#                own DNS (HTTP-01). The domain must point straight at the VPS
#                (no proxy or CDN in front) and port 80 must be open to the
#                internet before Traefik first sees this router.
TRAEFIK_CERT_RESOLVER=cloudflare

# ── WordPress (docker/wp-config.php) ────────────────────────────────────────
# The public URL, scheme included (WP_HOME and WP_SITEURL). Wrong here means
# redirect loops behind Traefik.
WORDPRESS_URL=https://${APP_DOMAIN}
# Required. All eight keys and salts are derived from it; changing it logs
# everyone out. At least 32 characters:  openssl rand -hex 32
WORDPRESS_SECRET=

WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
# Required: MariaDB will not initialise without one.  openssl rand -hex 24
WORDPRESS_DB_PASSWORD=
WORDPRESS_TABLE_PREFIX=wp_

# production (the default), staging, development or local.
# WORDPRESS_ENVIRONMENT_TYPE=production
# WP_DEBUG; errors go to the container output (docker compose logs app).
# WORDPRESS_DEBUG=false

# ── php-base ─────────────────────────────────────────────────────────────────
# The app container is healthy only when PHP-FPM answers AND WordPress itself
# loads (a database or wp-config.php error makes this a 500). Ignored by the
# scheduler, which is healthy while its cron runs succeed.
HEALTHCHECK_URL=http://127.0.0.1:8080/wp-login.php

# Optional runtime overrides; the defaults suit most sites.
# PHP_MEMORY_LIMIT=256M
# PHP_UPLOAD_MAX_FILESIZE=64M    # Cloudflare's free plan caps a request at 100 MB
# PHP_POST_MAX_SIZE=64M          # raising it? size the /tmp tmpfs to 2 x this + 32 MB
# NGINX_FASTCGI_READ_TIMEOUT=300s
# FPM_MAX_CHILDREN=auto          # sized from mem_limit; see README.md
