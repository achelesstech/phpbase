# WordPress core and wp-cli are downloaded during the build. The context holds
# only wp-config.php and your own wp-content/: keeps it small and secrets out.
*
!docker/wp-config.php
!wp-content/

# Runtime state, never baked into the image.
wp-content/uploads
wp-content/cache
wp-content/upgrade
wp-content/debug.log
**/.git
**/node_modules
