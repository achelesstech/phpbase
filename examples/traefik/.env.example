# =============================================================================
# examples/traefik/.env  —  copy to .env and edit
# =============================================================================
# This file is read by DOCKER COMPOSE only.
#
# It is NOT read by config/traefik.yml. Traefik does not expand ${VAR} in its
# static config, so anything that looks like a setting there — the ACME email,
# the trusted IP list, the resolver names — has to be edited in that file.
# Your previous compose passed ACME_EMAIL in as an environment variable; it had
# no effect, because nothing reads it.
# =============================================================================

# Container timezone. Affects log timestamps only.
TZ=Asia/Dhaka

# Hostname for the Traefik dashboard. Required — compose refuses to start
# without it rather than publishing a dashboard on a name you did not choose.
# Point it at a real DNS record; the cert is issued over DNS-01 so the name
# does not have to be publicly reachable.
TRAEFIK_DOMAIN=traefik.example.com

# Group that owns the Docker socket on this host. The socket proxy runs as
# nobody and joins this group to read the socket. Required, and it differs
# between hosts, so look it up:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=

# -----------------------------------------------------------------------------
# NOT here: the Cloudflare API token.
# -----------------------------------------------------------------------------
# It goes in ./secrets/cf_dns_api_token as a file, so it never appears in
# `docker inspect`, `docker compose config`, or the process environment of
# anything but Traefik.
#
#   make token
#
# Create it at Cloudflare -> My Profile -> API Tokens -> Create Token, using
# the "Edit zone DNS" template:
#
#   Permissions:  Zone / DNS / Edit
#                 Zone / Zone / Read
#   Zone Resources: Include / Specific zone / example.com
#
# Do not use the Global API Key. It is account-wide, cannot be scoped, and
# cannot be revoked without breaking everything else that uses it.
