# =============================================================================
# Moodle on php-base — copy to .env and fill in. Never commit .env.
# =============================================================================
# Compose reads this file only for ${…} in compose.prod.yml, which hands each
# container just the values it needs: MOODLE_ADMIN_* reach the one-shot
# `install` alone, never app or scheduler. A new setting must therefore be
# added to compose.prod.yml (x-moodle-env) as well as here.

# ── Routing (compose.prod.yml, Traefik labels) ──────────────────────────────
# The public host name. Its DNS A/AAAA record points at the VPS. Moodle's
# wwwroot is https://${APP_DOMAIN}; changing it later breaks every link stored
# in course content (admin/tool/replace fixes that).
APP_DOMAIN=lms.example.com
# The Traefik router and service name. Unique on the HOST, not just in this
# file: two stacks with the same name silently merge into one route. Name it
# after the site (lms, campus), never `app`.
TRAEFIK_ROUTER=moodle
# Which certificate resolver issues the TLS certificate. Decided by where the
# domain's DNS is hosted, not where it was registered:
#   cloudflare   DNS on Cloudflare (DNS-01 through the Cloudflare API token).
#                The default.
#   letsencrypt  DNS anywhere else: Namecheap, GoDaddy, a local registrar, your
#                own DNS (HTTP-01). The domain must point straight at the VPS
#                (no proxy or CDN in front) and port 80 must be open to the
#                internet before Traefik first sees this router.
TRAEFIK_CERT_RESOLVER=cloudflare

# ── Database (PostgreSQL 18, read by config.php and the db service) ─────────
DB_HOST=db
DB_PORT=5432
DB_DATABASE=moodle
DB_USERNAME=moodle
# Required: PostgreSQL will not initialise without one.  openssl rand -hex 24
DB_PASSWORD=

# ── First install (the one-shot `install` service only) ─────────────────────
MOODLE_ADMIN_USER=admin
# Required for install. Moodle's password policy applies: at least 8
# characters with a digit, a lower- and an upper-case letter and a symbol.
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=
MOODLE_SITE_NAME=Moodle
MOODLE_SITE_SHORTNAME=moodle

# ── php-base ─────────────────────────────────────────────────────────────────
# Upload limits (compose.prod.yml defaults shown). post_max_size >= the
# largest upload; nginx's client_max_body_size follows it. /tmp is a volume
# for app, so raising these costs disk, not RAM. See README.md.
# PHP_UPLOAD_MAX_FILESIZE=512M
# PHP_POST_MAX_SIZE=512M
# PHP_MEMORY_LIMIT=512M
# FPM_MAX_CHILDREN=auto        # sized from mem_limit; see README.md
